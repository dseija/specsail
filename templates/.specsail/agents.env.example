# Copy to .specsail/agents.env (gitignored). Read by the First Mate when it runs
# a stage, and by .specsail/scripts/run-agent.sh for headless runs.
# The Captain chooses models here; an empty value uses the first entry of the
# role's default chain in the active adapter guide (for OpenCode:
# .specsail/adapters/opencode/README.md). Variants are part of the model
# string, e.g. opencode/claude-sonnet-5-5#high.

# CLI options for the optional headless runner: claude | codex | opencode | custom
AGENT_CLI=claude
# AGENT_CUSTOM_CMD="pi -p"      # used when a role's CLI is "custom"; prompt is appended as last arg

# Per-role overrides. Invoke a stage by its name or crew alias.
# Tier guidance: mid for manage; frontier for understand/plan/review;
# mid for acceptance-tests and implement; cheap for ship.
# Use a DIFFERENT model family for review than for implement.
#
# Default chains (first choice first). Each model lists the providers that
# serve it, tried left to right: go = opencode-go/, oc = opencode/.
# The adapter guide has the full table.
#   manage:            gpt-6-luna [go, oc] -> deepseek-v4.1-flash [go, oc] -> mimo-v2.6-flash [go] -> claude-sonnet-5-5 [oc] -> gemini-3.8-flash [oc] -> glm-5.3-flash [go, oc] -> qwen3.8-flash [go, oc]
#   understand:        claude-opus-5-5 [oc] -> gpt-6.1-sol [oc] -> gemini-4-argon [oc] -> kimi-k3 [go, oc] -> grok-4.7 [go, oc] -> deepseek-v4-pro [go, oc] -> mimo-v2.6-pro [go] -> glm-5.3 [go, oc] -> qwen3.8-max [go, oc]
#   plan:              claude-opus-5-5 [oc] -> gpt-6.1-sol [oc] -> kimi-k3 [go, oc] -> grok-4.7 [go, oc] -> deepseek-v4-pro [go, oc] -> mimo-v2.6-pro [go] -> gemini-4-argon [oc] -> glm-5.3 [go, oc] -> qwen3.8-max [go, oc]
#   acceptance-tests:  claude-sonnet-5-5 [oc] -> gpt-6-luna [go, oc] -> gemini-4-argon [oc] -> deepseek-v4.1-flash [go, oc] -> mimo-v2.6-flash [go] -> glm-5.3-flash [go, oc] -> qwen3.8-flash [go, oc]
#   implement:         claude-sonnet-5-5 [oc] -> gpt-6-luna [go, oc] -> deepseek-v4.1-flash [go, oc] -> mimo-v2.6-flash [go] -> gemini-4-argon [oc] -> glm-5.3-flash [go, oc] -> qwen3.8-flash [go, oc]
#   review:            gpt-6.1-sol [oc] -> claude-opus-5-5 [oc] -> kimi-k3 [go, oc] -> grok-4.7 [go, oc] -> deepseek-v4-pro [go, oc] -> mimo-v2.6-pro [go] -> gemini-4-argon [oc] -> glm-5.3 [go, oc] -> qwen3.8-max [go, oc]
#   ship:              mimo-v2.6-flash [go] -> deepseek-v4.1-flash [go, oc] -> claude-haiku-5-5 [go, oc] -> gpt-6-luna [go, oc] -> glm-5.3-flash [go, oc] -> gemini-3.8-flash [oc] -> qwen3.8-flash [go, oc]

AGENT_MODEL_MANAGE=
AGENT_MODEL_UNDERSTAND=
AGENT_MODEL_PLAN=
AGENT_MODEL_ACCEPTANCE_TESTS=
AGENT_MODEL_IMPLEMENT=
AGENT_MODEL_REVIEW=
AGENT_MODEL_SHIP=
AGENT_CLI_REVIEW=codex
