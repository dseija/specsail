# Copy to .specsail/agents.env (gitignored). Read by .specsail/scripts/run-agent.sh.
# CLI options: claude | codex | opencode | custom
AGENT_CLI=claude
# AGENT_CUSTOM_CMD="pi -p"      # used when a role's CLI is "custom"; prompt is appended as last arg

# Per-stage overrides. You may invoke a stage by either its name or crew alias.
# Tier guidance: frontier for understand/plan/acceptance-tests/review, mid/cheap for implement.
# Use a DIFFERENT model family for review.
AGENT_MODEL_UNDERSTAND=
AGENT_MODEL_PLAN=
AGENT_MODEL_ACCEPTANCE_TESTS=
AGENT_MODEL_IMPLEMENT=
AGENT_MODEL_REVIEW=
AGENT_CLI_REVIEW=codex
AGENT_MODEL_SHIP=
