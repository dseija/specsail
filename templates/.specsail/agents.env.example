# Copy to .specsail/agents.env (gitignored). Read by the First Mate when it runs
# a stage, and by .specsail/scripts/run-agent.sh for headless runs.
# The Captain chooses models here; an empty value uses the first entry of the
# role's default chain in the active adapter guide (for OpenCode:
# .specsail/adapters/opencode/README.md). Variants are part of the model
# string, e.g. opencode/claude-sonnet-5-5#high.

# CLI options for the optional headless runner: claude | codex | opencode | custom
AGENT_CLI=claude
# AGENT_CUSTOM_CMD="pi -p"      # used when a role's CLI is "custom"; prompt is appended as last arg

# Per-role overrides. Invoke a stage by its name or crew alias.
# Tier guidance: mid for manage; frontier for understand/plan/review;
# mid for acceptance-tests and implement; cheap for ship.
# Use a DIFFERENT model family for review than for implement.
#
# Default chains (first choice first). Prefixes are opencode/ except mimo-*,
# which is opencode-go/mimo-*. The adapter guide has the full table.
#   manage:            gpt-6-luna -> deepseek-v4.1-flash -> mimo-v2.6-flash -> claude-sonnet-5-5 -> gemini-3.8-flash -> glm-5.3-flash -> qwen3.8-flash
#   understand:        claude-opus-5-5 -> gpt-6.1-sol -> gemini-4-argon -> kimi-k3 -> grok-4.7 -> deepseek-v4-pro -> mimo-v2.6-pro -> glm-5.3 -> qwen3.8-max
#   plan:              claude-opus-5-5 -> gpt-6.1-sol -> kimi-k3 -> grok-4.7 -> deepseek-v4-pro -> mimo-v2.6-pro -> gemini-4-argon -> glm-5.3 -> qwen3.8-max
#   acceptance-tests:  claude-sonnet-5-5 -> gpt-6-luna -> gemini-4-argon -> deepseek-v4.1-flash -> mimo-v2.6-flash -> glm-5.3-flash -> qwen3.8-flash
#   implement:         claude-sonnet-5-5 -> gpt-6-luna -> deepseek-v4.1-flash -> mimo-v2.6-flash -> gemini-4-argon -> glm-5.3-flash -> qwen3.8-flash
#   review:            gpt-6.1-sol -> claude-opus-5-5 -> kimi-k3 -> grok-4.7 -> deepseek-v4-pro -> mimo-v2.6-pro -> gemini-4-argon -> glm-5.3 -> qwen3.8-max
#   ship:              mimo-v2.6-flash -> deepseek-v4.1-flash -> claude-haiku-5-5 -> gpt-6-luna -> glm-5.3-flash -> gemini-3.8-flash -> qwen3.8-flash

AGENT_MODEL_MANAGE=
AGENT_MODEL_UNDERSTAND=
AGENT_MODEL_PLAN=
AGENT_MODEL_ACCEPTANCE_TESTS=
AGENT_MODEL_IMPLEMENT=
AGENT_MODEL_REVIEW=
AGENT_MODEL_SHIP=
AGENT_CLI_REVIEW=codex
